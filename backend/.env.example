# SecureAccess Pro - environment configuration (copy to .env and edit)

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use a local SQLite file (zero-config demo).
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:admin123@localhost:5432/secureaccess_pro

# --- JWT / session ----------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRES_MINUTES=15

# --- MFA (TOTP) -------------------------------------------------------------
TOTP_ISSUER=SecureAccess Pro
TOTP_INTERVAL=30
TOTP_VALID_WINDOW=1

# --- Email OTP (code sent to the user's registered email) -------------------
# Leave SMTP_USER / SMTP_PASSWORD empty to run in DEV MODE (the code is printed
# to the server console instead of being emailed).
# For Gmail: create an App Password (Google Account > Security > App passwords)
# and set it as SMTP_PASSWORD (NOT your normal Gmail password).
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Brute-force protection -------------------------------------------------
MAX_FAILED_ATTEMPTS=3
LOCKOUT_MINUTES=15

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=true
